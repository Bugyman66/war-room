TWITTER_BEARER_TOKEN=your-twitter-bearer-token
NEWS_API_KEY=your-newsapi-key
YOUTUBE_API_KEY=your-youtube-data-api-key
REDIS_URL=redis://localhost:6379
RAPIDAPI_KEY=your-rapidapi-key
GNEWS_API_KEY=your-gnews-api-key
DATABASE_URL=postgresql://warroom:warroom@localhost:5432/warroom?schema=public
GEMINI_API_KEY=your-gemini-api-key
# Shared secret for the admin config editor. Writes to /api/config/* require
# this value in the `x-admin-token` header. Leave unset to disable all writes.
ADMIN_TOKEN=change-me-to-a-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000
# Poll budgets for quota-limited sources (defaults fit the free plans).
# Facebook (facebook-scraper3 free = 100 req/month): queries x polls must stay under it.
FACEBOOK_POLL_HOURS=24
FACEBOOK_QUERIES=Peter Obi,NDC Nigeria,Tinubu 2027
# Twitter154 free = 200 req/month.
TWITTER_POLL_HOURS=4
# YouTube Data API = 10,000 units/day, 100 per search.
YOUTUBE_POLL_MINUTES=15
